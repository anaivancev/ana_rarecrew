@model List<EmployeeStats>
@{
    ViewData["Title"] = "Employees";
}

<h1>Employee Time Tracker</h1>

<table>
    <thead>
        <tr>
            <th>Name</th>
            <th class="hours">Total time worked</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var employee in Model)
        {
            <tr class="@(employee.TotalHours < 100 ? "low-hours" : null)">
                <td>@employee.Name</td>
                <td class="hours">@employee.TotalHours.ToString("F2") hrs</td>
            </tr>
        }
    </tbody>
</table>

<p class="note">Highlighted rows: employees who worked less than 100 hours.</p>

<img class="chart" src="~/chart.png" asp-append-version="true" alt="Pie chart showing each employee's share of total time worked" />
